---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve Thursday stand-ups: what to bring, the trick of the week, what happens in the room, and how you know it worked."
  {...siteConfig}
>
  <p>
    One stand-up a week, on Thursdays. Each one gives you a trick, makes you
    use it on your own work, and ends with a short list you can check
    yourself. Week 10 has no trick. That is the point of week 10.
  </p>
  <SessionsGrid />
</ContentLayout>
