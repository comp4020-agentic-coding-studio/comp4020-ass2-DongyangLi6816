---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import WeekChain from "../../components/WeekChain.astro";
import { formatCourseDate } from "../../lib/dates";
import { getWeekContext } from "../../lib/week-graph";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);
// `trick` is a course-specific key the schema passes through untyped.
const trick = typeof session.data.trick === "string" ? session.data.trick : undefined;
const context = await getWeekContext(session.data.week, "sessions");
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <p><strong>{formatCourseDate(session.data.date)}</strong></p>
  <WeekChain
    collection="sessions"
    noun={sessionLabels.singular.toLowerCase()}
    buildsOn={context.buildsOn}
    feeds={context.feeds}
  />
  {trick && <p class="trick"><strong>This week's trick:</strong> {trick}</p>}
  <Content />
  <SpecList spec={session.data.spec}>
    Before you leave the room. Each line is something you can check yourself.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
</ContentLayout>

<style>
  .trick {
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--at-accent, currentColor);
    background: var(--at-bg-alt, transparent);
  }
</style>
