---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import WeekChain from "../../components/WeekChain.astro";
import WeekNav from "../../components/WeekNav.astro";
import { formatCourseDate } from "../../lib/dates";
import { getWeekContext } from "../../lib/week-graph";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);
// `trick` and `cost` are course-specific keys the schema passes through untyped.
const trick = typeof session.data.trick === "string" ? session.data.trick : undefined;
const cost = typeof session.data.cost === "string" ? session.data.cost : undefined;
const context = await getWeekContext(session.data.week, "sessions");
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <p><strong>{formatCourseDate(session.data.date)}</strong></p>
  <WeekChain
    collection="sessions"
    noun={sessionLabels.singular.toLowerCase()}
    buildsOn={context.buildsOn}
    feeds={context.feeds}
  />
  {
    trick ? (
      <p class="trick">
        <span class="trick-label">This week's trick</span>
        {trick}
      </p>
    ) : (
      <p class="register-absent">No trick this week.</p>
    )
  }
  {
    cost ? (
      <p class="cost">
        <span class="cost-label">Who pays</span>
        {cost}
      </p>
    ) : (
      <p class="register-absent">No cost named this week.</p>
    )
  }
  <Content />
  <SpecList spec={session.data.spec}>
    Before you leave the room. Each line is something you can check yourself.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
  <WeekNav
    collection="sessions"
    label={sessionLabels.plural}
    week={context.week}
    total={context.total}
    previous={context.previous}
    next={context.next}
  />
</ContentLayout>

<style>
  /* The course keeps three registers apart: the trick is written in corporate
     voice, the mechanism in plain English, and the cost line names who pays
     for the trick, in plain English too but as a verdict, not an explanation.
     The trick and the cost share this page, so how they are set is the only
     thing that carries the rule to a reader. The trick is set as the office
     artefact it imitates --- ruled box, tinted ground, filed under a label.
     Its opposite number is `.mechanism` in `src/pages/lectures/[slug].astro`,
     which deliberately gets no chrome at all; restyling one only works if the
     other still looks unlike it. */
  .trick {
    margin-block: var(--at-spacing-md) var(--at-spacing-lg);
    padding: var(--at-spacing-md);
    border: 1px solid var(--at-border);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  .trick-label {
    display: block;
    margin-block-end: 0.35rem;
    color: var(--at-text-secondary);
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The cost is neither a box nor an explanation: one rule down the side,
     secondary ink, the label on its own line. It sits under the trick and
     must not read as part of it, so it shares nothing with `.trick` but the
     vertical rhythm. */
  .cost {
    margin-block: 0 var(--at-spacing-lg);
    padding-inline-start: var(--at-spacing-md);
    border-inline-start: 2px solid var(--at-border);
    color: var(--at-text-secondary);
  }

  .cost-label {
    display: block;
    margin-block-end: 0.15rem;
    font-size: var(--at-font-size-sm);
    font-style: italic;
  }

  /* Week 10 has no trick, and that absence is the week's argument, so it is
     set as an absence rather than left as a gap the reader cannot see.
     `spec/course.test.ts` holds it to exactly one such week. Every week names
     a cost, so the cost's absence marker is a fallback, not a design. */
  .register-absent {
    margin-block: var(--at-spacing-md) var(--at-spacing-lg);
    color: var(--at-text-secondary);
    font-style: italic;
  }
</style>
