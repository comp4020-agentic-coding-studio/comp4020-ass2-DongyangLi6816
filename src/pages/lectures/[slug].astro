---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import LectureWeekTable from "../../components/LectureWeekTable.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import WeekChain from "../../components/WeekChain.astro";
import WeekNav from "../../components/WeekNav.astro";
import { formatCourseDate } from "../../lib/dates";
import { getWeekContext } from "../../lib/week-graph";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
// The one week with no trick and no mechanism, on purpose. It gets no table and
// keeps its "No mechanism this week." line; any other week missing a value
// fails the build inside `LectureWeekTable`.
const NO_TRICK_WEEK = 10;
// `mechanism`, `seen` and `sources` are course-specific keys the schema passes through untyped.
const mechanism = typeof lecture.data.mechanism === "string" ? lecture.data.mechanism : undefined;
const sources = Array.isArray(lecture.data.sources)
  ? (lecture.data.sources as { title: string; url: string }[])
  : [];
const context = await getWeekContext(lecture.data.week, "lectures");
---

<ContentLayout title={title} description={lecture.data.description} {...siteConfig}>
  <p><strong>{formatCourseDate(lecture.data.date)}</strong></p>
  {lecture.data.slides && <p><a href={withBase(lecture.data.slides)}>Open the slides</a></p>}
  <WeekChain
    collection="lectures"
    noun="lecture"
    buildsOn={context.buildsOn}
    feeds={context.feeds}
  />
  {
    lecture.data.week !== NO_TRICK_WEEK && (
      <LectureWeekTable
        week={lecture.data.week}
        mechanism={lecture.data.mechanism}
        seen={lecture.data.seen}
      />
    )
  }
  {
    mechanism ? (
      <p class="mechanism">
        <span class="mechanism-label">Why it works</span>
        {mechanism}
      </p>
    ) : (
      <p class="register-absent">No mechanism this week.</p>
    )
  }
  <Content />
  {
    sources.length > 0 && (
      <>
        <h2>Sources</h2>
        <ul>
          {sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} />
  <WeekNav
    collection="lectures"
    label="Lectures"
    week={context.week}
    total={context.total}
    previous={context.previous}
    next={context.next}
  />
</ContentLayout>

<style>
  /* The course keeps three registers apart: the trick is written in
     corporate voice, the mechanism in plain English, and the cost line (on
     the stand-up page) names who pays. They live on separate pages, so the
     only thing that can carry that rule to a reader is how they are set.
     Plain English gets no chrome --- no box, no rule, no tint --- just room.
     Its opposite numbers are `.trick` and `.cost` in
     `src/pages/sessions/[slug].astro`; if you restyle one, the set only
     works if the others still look unlike it. */
  .mechanism {
    margin-block: var(--at-spacing-md) var(--at-spacing-lg);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .mechanism-label {
    display: block;
    color: var(--at-text-secondary);
    font-size: var(--at-font-size-base);
    font-style: italic;
  }

  /* Week 10 has no mechanism, and that absence is the week's argument, so it
     is set as an absence rather than left as a gap the reader cannot see.
     `spec/course.test.ts` holds it to exactly one such week. */
  .register-absent {
    margin-block: var(--at-spacing-md) var(--at-spacing-lg);
    color: var(--at-text-secondary);
    font-style: italic;
  }
</style>
